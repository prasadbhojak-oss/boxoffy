{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "boxoffy.com" }],
      "destination": "https://www.boxoffy.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/ramayana",
      "destination": "/ramayana.html"
    },
    {
      "source": "/((?!.*\\.html$|.*\\.xml$|.*\\.txt$|.*\\.json$|.*\\.js$|.*\\.css$|.*\\.png$|.*\\.jpg$|.*\\.ico$|.*\\.svg$|.*\\.webp$|.*\\.woff2?$|.*\\.ttf$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=86400, s-maxage=86400" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" }
      ]
    },
    {
      "source": "/ramayana-map.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=60, s-maxage=60, stale-while-revalidate=600" }
      ]
    },
    {
      "source": "/ramayana.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, s-maxage=300" }
      ]
    }
  ]
}
